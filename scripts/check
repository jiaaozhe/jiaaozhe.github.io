#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

export JEKYLL_ENV=production
bundle exec jekyll build
bundle exec ruby scripts/validate_site.rb
bundle exec ruby scripts/test_site_index.rb
for file in assets/js/*.js scripts/*.js; do
  node --check "$file"
done
node scripts/smoke_site_ai.js
node --test scripts/test_*.js
